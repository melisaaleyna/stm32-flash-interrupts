 147:Core/Src/main.c ****     {
ARM GAS  C:\Users\melis\AppData\Local\Temp\cc1BouUo.s 			page 4


 148:Core/Src/main.c ****         // Eğer süre ölçümü henüz başlamadıysa şimdi başlat
 149:Core/Src/main.c ****         if (button_press_start == 0) 
 150:Core/Src/main.c ****         {
 151:Core/Src/main.c ****             button_press_start = HAL_GetTick(); // Mevcut milisaniyeyi kaydet
 152:Core/Src/main.c ****         } 
 153:Core/Src/main.c ****         // 3 saniye (3000 ms) geçtiyse ve henüz sıfırlama yapılmadıysa
 154:Core/Src/main.c ****         else if ((HAL_GetTick() - button_press_start >= 3000) && !button_held) 
 155:Core/Src/main.c ****         {
 156:Core/Src/main.c ****             button_held = 1;      // Tekrar tekrar çalışmasın diye işaretle
 157:Core/Src/main.c ****             blink_count = 4;      // Fabrika ayarlarına dön
 158:Core/Src/main.c ****             Write_Flash(blink_count); // Yeni değeri kalıcı hafızaya yaz
 159:Core/Src/main.c ****         }
 160:Core/Src/main.c ****     } 
 161:Core/Src/main.c ****     // Buton bırakıldığında (Cımbız çekildiğinde) süreleri sıfırla
 162:Core/Src/main.c ****     else 
 163:Core/Src/main.c ****     {
 164:Core/Src/main.c ****         button_press_start = 0;
 165:Core/Src/main.c ****         button_held = 0;
 166:Core/Src/main.c ****     }
 167:Core/Src/main.c **** 
